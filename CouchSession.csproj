<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>CouchSession</AssemblyName>
    <RootNamespace>CouchMode</RootNamespace>
    <Version>0.9.14</Version>
    <Product>Couch Session</Product>
    <Description>Steam Big Picture on your TV — one click there and back.</Description>
    <Company>Couch Session</Company>
    <AssemblyTitle>Couch Session</AssemblyTitle>
    <!-- Conditional, so a missing icon is a plainer icon rather than a failed build.
         Two reasons. The icon is generated from the app's own mark by the write-icon switch
         (see Ui/IconFile.cs), and a hard reference makes that circular: you cannot build the tool that
         writes the file the build refuses to start without. And a fresh clone that has not generated
         one yet should compile and run, not stop at CS7064 with an error about an image. -->
    <ApplicationIcon Condition="Exists('assets/CouchSession.ico')">assets/CouchSession.ico</ApplicationIcon>

    <!-- Single portable exe, no runtime install required -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- No trimming: the SDK hard-blocks it for WinForms (NETSDK1175), because the framework
         relies on reflection the trimmer can't follow. Costs binary size, nothing else.
         NativeAOT is also out: it cannot do built-in COM, which IPolicyConfig needs. -->
    <PublishTrimmed>false</PublishTrimmed>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the tray icon and window icon come from the same file as the exe icon,
         with no loose asset to ship alongside the single-file build. -->
    <EmbeddedResource Include="assets/CouchSession.ico" LogicalName="CouchSession.ico" />

    <!-- The easter egg is gone. It was embedded, and the gif alone was 52 MB — over half the size of
         the finished executable, on a download people are asked to take on trust from an unsigned
         beta. A joke nobody can find is not worth doubling what everyone downloads. -->

    <!-- The console button artwork hook is gone along with the marks themselves. The app no longer
         draws anything brand-specific: one generic guide-button mark serves every controller, so
         there is nothing left for a licensed image to replace. See Ui/GuideMark.cs. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Backup snapshots live inside the project folder (the working tree is all the sandbox can
         reach), and the SDK's default globbing would compile every .cs in them — defining the whole
         app twice. Anything under a folder starting with _backup is source to keep, not source to
         build.

         _to_delete is the same problem arriving from the other direction: files taken out of the app
         and parked there until they are binned for good. The globbing pulled them straight back into
         the compile, so removing a file appeared to break the build — StarLegend.cs went first and
         failed on the Words constant that was deleted with it. Parked is not the same as gone, and
         until it is gone the compiler must not see it. -->
    <Compile Remove="_backup*/**/*.cs" />
    <EmbeddedResource Remove="_backup*/**/*" />
    <None Remove="_backup*/**/*" />
    <Content Remove="_backup*/**/*" />

    <Compile Remove="_to_delete/**/*.cs" />
    <EmbeddedResource Remove="_to_delete/**/*" />
    <None Remove="_to_delete/**/*" />
    <Content Remove="_to_delete/**/*" />
  </ItemGroup>

</Project>
