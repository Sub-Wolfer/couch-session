# Build output
bin/
obj/
build/out/
publish/

# The finished single-file executable, which publish.cmd copies up to the project root.
# 119 MB — self-contained builds embed the whole .NET runtime. Ships as a release asset, not in git.
CouchSession.exe
*.zip

# Local snapshots kept inside the project folder. The csproj already excludes these from
# compilation; this keeps them out of history as well.
_backup*/
_to_delete/
*.bak

# The landing page, kept out of the code repository.
#
# It is a separate deliverable with its own life — nobody cloning this to build the app needs it, and
# it would otherwise turn every wording tweak on the site into a commit against the application.
website/

# A standalone scratch tool ("Couch Mode — text editor"), not part of the application. Nothing in the
# codebase references it and it does not ship, so it has no business being the first thing a visitor
# to the repository wonders about.
TextEditor.html

# Visual Studio / Rider / VS Code
.vs/
.idea/
*.user
*.suo
*.userprefs
.vscode/
